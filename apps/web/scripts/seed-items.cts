async function main() {
  console.log(`Seeding ${ITEMS.length} assessment items...`);
  const client = await pool.connect();

  try {
    let upserted = 0;
    for (const item of ITEMS) {
      await client.query(
        `INSERT INTO item (id, stem, choices, dimension, difficulty_b, created_at)
         VALUES ($1, $2, $3::jsonb, $4, $5, NOW())
         ON CONFLICT (id) DO UPDATE
           SET stem        = excluded.stem,
               choices     = excluded.choices,
               dimension   = excluded.dimension,
               difficulty_b = excluded.difficulty_b`,
        [item.id, item.stem, JSON.stringify(item.choices), item.dimension, item.difficultyB]
      );
      upserted++;
    }
    console.log(`  [ok] ${upserted} items upserted`);
    console.log("\nDone.");
  } finally {
    client.release();
    await pool.end();
  }
}

main().catch((err) => { console.error(err); process.exit(1); });
