  { id: "be-sd-2", dimension: "system_design", difficultyB: 0.5, stem: "A homepage query aggregates 3 months of sales data on every page load, taking 3 seconds. Best fix:", choices: [{ id: "a", label: "Add a database index on the sales date column", correct: false }, { id: "b", label: "Run the aggregation on a schedule and cache the result; serve the cached value on page load", correct: true }, { id: "c", label: "Increase the read replica count", correct: false }, { id: "d", label: "Move the aggregation logic to client-side JavaScript", correct: false }] },
  { id: "be-sd-3", dimension: "system_design", difficultyB: 0.5, stem: "An `events` table takes 50,000 writes/minute from IoT devices and serves 200 concurrent dashboard reads. Dashboard queries are slow. Best architectural fix:", choices: [{ id: "a", label: "Partition the events table by month", correct: false }, { id: "b", label: "Add a read replica and route all dashboard queries to it — separates read and write load", correct: true }, { id: "c", label: "Migrate the dashboard to query from a Redis cache", correct: false }, { id: "d", label: "Switch to a NoSQL database for higher write throughput", correct: false }] },
  { id: "be-obs-1", dimension: "observability", difficultyB: 0, stem: "A user reports their checkout failed. You have no error logs. Which practice would have made root-cause analysis instant?", choices: [{ id: "a", label: "Log every database query and its execution time", correct: false }, { id: "b", label: "Structured logs with correlation IDs tying together every request, service call, and DB query for a single session", correct: true }, { id: "c", label: "Increase log verbosity to DEBUG level across all services", correct: false }, { id: "d", label: "Alert when CPU exceeds 80% on the checkout service", correct: false }] },
  { id: "be-obs-2", dimension: "observability", difficultyB: 0.5, stem: "Your distributed system has 8 services. A request fails and you cannot tell which service is responsible. Best fix:", choices: [{ id: "a", label: "Add health check endpoints to every service", correct: false }, { id: "b", label: "Implement distributed tracing — propagate a trace ID through all service calls to see the full request path and latency breakdown", correct: true }, { id: "c", label: "Centralise all services onto one server so there is only one log stream", correct: false }, { id: "d", label: "Add error counters per service and alert when errors exceed 1%", correct: false }] },
  { id: "be-obs-3", dimension: "observability", difficultyB: 1, stem: "Your SLO is 99.9% uptime. An alert fires at 500 errors/minute absolute count. A slow degradation holds 400 errors/minute for 2 hours without alerting. Better strategy:", choices: [{ id: "a", label: "Lower the threshold to 200 errors/minute", correct: false }, { id: "b", label: "Alert on error RATE (errors ÷ total requests) — absolute count thresholds miss proportional degradation", correct: true }, { id: "c", label: "Manually review logs every 30 minutes", correct: false }, { id: "d", label: "Alert when response p95 latency exceeds 2 seconds instead", correct: false }] },
  { id: "be-auth-1", dimension: "auth_security", difficultyB: 0, stem: "You are designing JWT-based auth. What is the correct access token lifespan strategy for a banking app?", choices: [{ id: "a", label: "24-hour access tokens — fewer refresh calls, better UX", correct: false }, { id: "b", label: "Short-lived access tokens (15 min) + long-lived refresh tokens (7 days) stored in an httpOnly cookie", correct: true }, { id: "c", label: "Never-expiring access tokens stored in localStorage for convenience", correct: false }, { id: "d", label: "One-hour access tokens with no refresh mechanism — force re-login hourly", correct: false }] },
  { id: "be-auth-2", dimension: "auth_security", difficultyB: 0.5, stem: "A user with role 'viewer' calls DELETE /posts/123 by forging the HTTP request from the browser. Your React UI hides the delete button for viewers. Best fix:", choices: [{ id: "a", label: "Obfuscate the delete endpoint URL — viewers can't discover it", correct: false }, { id: "b", label: "The UI already prevents it — no server change needed", correct: false }, { id: "c", label: "Check the user's role server-side in the DELETE handler and return 403 if they lack permission", correct: true }, { id: "d", label: "Rate-limit the delete endpoint to prevent abuse", correct: false }] },
  { id: "be-auth-3", dimension: "auth_security", difficultyB: 1, stem: "Your mobile app uses OAuth 2.0. A public client cannot safely store a client_secret. Which flow prevents authorization code interception attacks?", choices: [{ id: "a", label: "Implicit flow — returns the token directly in the redirect URL without a code", correct: false }, { id: "b", label: "Client credentials flow — uses client_id + client_secret server-to-server", correct: false }, { id: "c", label: "Authorization code flow with PKCE — the code_verifier proves the initiator is the same client that received the code", correct: true }, { id: "d", label: "Resource owner password credentials flow — send username and password directly to the token endpoint", correct: false }] },
  { id: "be-cache-1", dimension: "caching", difficultyB: 0, stem: "Which data is the best candidate to cache in Redis?", choices: [{ id: "a", label: "A user's account balance — changes on every transaction", correct: false }, { id: "b", label: "The result of a public homepage query that aggregates 1M rows and changes hourly", correct: true }, { id: "c", label: "Raw user passwords — never hit the DB for auth", correct: false }, { id: "d", label: "Database schema definitions — they never change at runtime", correct: false }] },
  { id: "be-cache-2", dimension: "caching", difficultyB: 0.5, stem: "You write a new product to the database and return it to the API caller. Your Redis cache still serves the old product list to other callers. Best cache invalidation approach:", choices: [{ id: "a", label: "Wait for the TTL to expire — eventually consistent is fine for products", correct: false }, { id: "b", label: "Delete the product list cache key immediately after the DB write succeeds", correct: true }, { id: "c", label: "Write the new product to Redis before writing to the database", correct: false }, { id: "d", label: "Use a background job to sync Redis with the DB every 5 minutes", correct: false }] },
  { id: "be-cache-3", dimension: "caching", difficultyB: 1, stem: "A cache key expires. 500 concurrent requests all miss the cache at once, flood the database, and cause a timeout cascade. This is called a cache stampede. Best prevention:", choices: [{ id: "a", label: "Increase the Redis TTL to reduce expiry frequency", correct: false }, { id: "b", label: "Use a probabilistic early recomputation (PER) or a distributed lock so only one request rebuilds the cache while others wait or serve stale", correct: true }, { id: "c", label: "Add more database replicas to absorb the spike", correct: false }, { id: "d", label: "Set different TTLs per key so they expire at different times", correct: false }] },
  { id: "be-test-1", dimension: "testing", difficultyB: 0, stem: "You are testing an endpoint that reads from the database and sends an email. Which test type verifies the full path without mocking the database or email service?", choices: [{ id: "a", label: "Unit test — mocks all dependencies so it runs in isolation", correct: false }, { id: "b", label: "Integration test — runs the handler against a real (or containerised) database and a test SMTP sink", correct: true }, { id: "c", label: "Snapshot test — captures and compares serialised output", correct: false }, { id: "d", label: "Load test — sends 1000 concurrent requests to verify throughput", correct: false }] },
  { id: "be-test-2", dimension: "testing", difficultyB: 0.5, stem: "Your service sends emails via an EmailService interface. In tests you want to verify that the right method was called with the right arguments without actually sending email. The right test double is:", choices: [{ id: "a", label: "A stub — returns pre-programmed responses but records no calls", correct: false }, { id: "b", label: "A mock — records calls and lets you assert method name, args, and call count", correct: true }, { id: "c", label: "A fake — a lightweight working implementation (e.g., in-memory email store) — correct for some cases but doesn't let you assert call signatures", correct: false }, { id: "d", label: "A spy wrapping the real EmailService — risks actually sending emails in CI", correct: false }] },
  { id: "be-test-3", dimension: "testing", difficultyB: 1, stem: "You expose a public REST API consumed by 3 external teams. Which testing strategy best prevents you from breaking consumers when you refactor?", choices: [{ id: "a", label: "100% unit test coverage on every service method", correct: false }, { id: "b", label: "End-to-end tests against the production API before each release", correct: false }, { id: "c", label: "Consumer-driven contract tests — each consumer publishes a contract; your CI validates the provider meets all contracts", correct: true }, { id: "d", label: "Manual regression testing of the top 10 API endpoints before release", correct: false }] },
  { id: "be-del-1", dimension: "delivery", difficultyB: 0, stem: "Your Docker image rebuilds the entire dependency layer on every code change, making CI take 8 minutes. Best fix:", choices: [{ id: "a", label: "Use a smaller base image — alpine instead of ubuntu", correct: false }, { id: "b", label: "Copy package.json and run `npm install` BEFORE copying the source code — Docker caches the dependency layer if package.json hasn't changed", correct: true }, { id: "c", label: "Run Docker build with `--no-cache` to ensure a clean build each time", correct: false }, { id: "d", label: "Build the image locally and push it to the registry to skip CI building", correct: false }] },
  { id: "be-del-2", dimension: "delivery", difficultyB: 0.5, stem: "Your backend CI pipeline should gate deploys effectively. The correct step order is:", choices: [{ id: "a", label: "Deploy → Test → Lint — test in production for real signals", correct: false }, { id: "b", label: "Lint → Unit tests → Integration tests → Build → Deploy — fail fast on cheap checks first", correct: true }, { id: "c", label: "Build → Deploy → Lint → Test — all checks run post-deploy for speed", correct: false }, { id: "d", label: "Test → Deploy → Lint — linting is optional in a fast-moving team", correct: false }] },
  { id: "be-del-3", dimension: "delivery", difficultyB: 1, stem: "You deploy v2 of a critical payment service. v2 has a data-loss bug. You need to roll back to v1 within 2 minutes with zero dropped requests. Which deployment strategy enables this?", choices: [{ id: "a", label: "Recreate deployment — stop v1 entirely, start v2", correct: false }, { id: "b", label: "Rolling deployment — replace v1 pods one by one with v2", correct: false }, { id: "c", label: "Blue/green deployment — v1 (blue) stays live; route traffic to v2 (green); switch back to blue in one DNS/LB change on rollback", correct: true }, { id: "d", label: "Canary deployment — gradually shift traffic to v2 over 30 minutes", correct: false }] },
  { id: "be-ss-1", dimension: "soft_skills", difficultyB: 0, stem: "A teammate's PR has a variable named `x` and no comments in a 200-line function. The code works. The best PR review comment is:", choices: [{ id: "a", label: "Approve it — it works, and style is subjective", correct: false }, { id: "b", label: "Block it with 'This code is unreadable, rewrite it'", correct: false }, { id: "c", label: "Leave specific, actionable suggestions: rename `x` to describe what it holds, and extract the function with a clear name", correct: true }, { id: "d", label: "Comment only on bugs — readability is the author's responsibility", correct: false }] },
  { id: "be-ss-2", dimension: "soft_skills", difficultyB: 0.5, stem: "Halfway through a sprint, a PM adds a new 'critical' feature that would double your workload. Best response:", choices: [{ id: "a", label: "Accept it and work overtime to deliver everything", correct: false }, { id: "b", label: "Refuse — the sprint scope was agreed and changes are not allowed", correct: false }, { id: "c", label: "Quantify the impact, present the trade-off (what gets dropped or delayed), and let the PM and team decide with full information", correct: true }, { id: "d", label: "Quietly drop a lower-priority task without telling anyone to make room", correct: false }] },
  { id: "be-ss-3", dimension: "soft_skills", difficultyB: 1, stem: "In a design review, two senior engineers strongly disagree on whether to use REST or gRPC. The meeting is going in circles. As the driver, best next step:", choices: [{ id: "a", label: "Pick REST — it is the safer default and will end the debate", correct: false }, { id: "b", label: "Table the decision and reconvene next week with fresh minds", correct: false }, { id: "c", label: "Timebox to 5 more minutes, identify the concrete constraints that differ (latency, external consumers, team familiarity), agree on criteria, and make a decision or escalate with a documented trade-off", correct: true }, { id: "d", label: "Let the most senior engineer decide — their experience should break the tie", correct: false }] },
  { id: "be-en-1", dimension: "english", difficultyB: 0, stem: "You open a PR that adds Redis caching to 3 endpoints. The best one-line PR title is:", choices: [{ id: "a", label: "\"fix: changes\"", correct: false }, { id: "b", label: "\"feat: add Redis caching to product, category, and user-profile endpoints\"", correct: true }, { id: "c", label: "\"WIP: caching stuff\"", correct: false }, { id: "d", label: "\"refactor: performance improvements across the board\"", correct: false }] },
  { id: "be-en-2", dimension: "english", difficultyB: 0.5, stem: "Production is degraded. You need to send an async Slack update to stakeholders. The best message is:", choices: [{ id: "a", label: "\"Something is broken, we are working on it.\"", correct: false }, { id: "b", label: "\"[INCIDENT] Checkout latency elevated (p99: 8s, normal: 400ms). Root cause: Redis connection pool exhausted. Fix: scaling pool size. ETA to resolve: 20 min. Next update: 14:30.\"", correct: true }, { id: "c", label: "\"The team is aware and handling the situation.\"", correct: false }, { id: "d", label: "Nothing until the incident is fully resolved — updates mid-incident cause panic", correct: false }] },
  { id: "be-en-3", dimension: "english", difficultyB: 1, stem: "You write an RFC proposing to replace the monolith's synchronous inter-module calls with an event-driven architecture. Which RFC structure is most likely to get cross-team alignment?", choices: [{ id: "a", label: "Problem → Proposed solution → Implementation timeline", correct: false }, { id: "b", label: "Problem → Context & constraints → Options considered (with trade-offs) → Recommendation → Open questions", correct: true }, { id: "c", label: "Solution → Why it is correct → Migration steps", correct: false }, { id: "d", label: "Background reading list → Architecture diagram → Action items", correct: false }] },

  // ─── Frontend Engineer (12 items) ────────────────────────────────────────────
  { id: "fe-js-1", dimension: "javascript", difficultyB: 0, stem: "`for (var i = 0; i < 3; i++) { setTimeout(() => console.log(i), 0); }` logs 3, 3, 3 instead of 0, 1, 2. Why?", choices: [{ id: "a", label: "`setTimeout` is broken inside loops", correct: false }, { id: "b", label: "`var` is function-scoped; all three closures share the same `i` variable, which is 3 by the time the callbacks run", correct: true }, { id: "c", label: "The event loop loses loop context when running deferred callbacks", correct: false }, { id: "d", label: "Arrow functions do not capture outer variables in closures", correct: false }] },
  { id: "fe-js-2", dimension: "javascript", difficultyB: 0.5, stem: "Function signature: `process<T extends { id: string }>(items: T[]): Map<string, T>`. What does `T extends { id: string }` enforce?", choices: [{ id: "a", label: "`T` must be exactly `{ id: string }` — no additional properties", correct: false }, { id: "b", label: "`T` must be a class that extends a base class with an `id` property", correct: false }, { id: "c", label: "`T` can be any type as long as it has at least an `id: string` property — additional properties are allowed", correct: true }, { id: "d", label: "The function only accepts string arrays", correct: false }] },
  { id: "fe-js-3", dimension: "javascript", difficultyB: 0.5, stem: "`Promise.all([fetchUser(), fetchOrders(), fetchCart()])` vs three sequential `await` calls. When should you prefer `Promise.all`?", choices: [{ id: "a", label: "When the promises depend on each other's results", correct: false }, { id: "b", label: "When you need separate error handling for each call", correct: false }, { id: "c", label: "When all three fetches are independent — `Promise.all` runs them concurrently, reducing total wait time", correct: true }, { id: "d", label: "When any one failure should cancel the others automatically", correct: false }] },
  { id: "fe-fw-1", dimension: "frameworks", difficultyB: 0, stem: "React warns about missing `key` props in a list. What does the `key` prop actually do?", choices: [{ id: "a", label: "It is a CSS identifier for styling list items", correct: false }, { id: "b", label: "It prevents components from re-rendering unnecessarily", correct: false }, { id: "c", label: "It helps React's reconciler identify which items changed, were added, or removed — enabling efficient DOM updates", correct: true }, { id: "d", label: "It passes a unique identifier as a prop to the child component", correct: false }] },
  { id: "fe-fw-2", dimension: "frameworks", difficultyB: 0, stem: "A `useEffect` has `[userId]` as its dependency array. When does this effect re-run?", choices: [{ id: "a", label: "On every render, regardless of what changed", correct: false }, { id: "b", label: "Only once — after the first render", correct: false }, { id: "c", label: "After the first render, and again whenever `userId` changes between renders", correct: true }, { id: "d", label: "Only when the component is unmounted and remounted", correct: false }] },
  { id: "fe-fw-3", dimension: "frameworks", difficultyB: 0.5, stem: "In Next.js App Router, when should you add `'use client'` to a component?", choices: [{ id: "a", label: "Always — Client Components are faster because they run in the browser", correct: false }, { id: "b", label: "Only when you need interactivity, browser APIs, or React hooks like `useState` or `useEffect`", correct: true }, { id: "c", label: "For all components that render HTML — Server Components are only for data fetching", correct: false }, { id: "d", label: "Server Components are only for API routes; pages should always be Client Components", correct: false }] },
  { id: "fe-perf-1", dimension: "performance", difficultyB: 0, stem: "Your page's LCP is 4.8 seconds. The LCP element is a hero image loaded from your CDN. Best first fix:", choices: [{ id: "a", label: "Reduce the image file size with better compression", correct: false }, { id: "b", label: "Add `<link rel='preload' as='image'>` for the hero image so the browser discovers and fetches it earlier in the waterfall", correct: true }, { id: "c", label: "Move the image to a faster CDN provider", correct: false }, { id: "d", label: "Add `loading='lazy'` to the image element", correct: false }] },
  { id: "fe-perf-2", dimension: "performance", difficultyB: 0.5, stem: "Your JavaScript bundle is 1.2 MB. Most users only visit the home page but download code for the dashboard, settings, and admin panel too. Best fix:", choices: [{ id: "a", label: "Minify and compress the bundle with gzip", correct: false }, { id: "b", label: "Move all non-critical components to a web worker", correct: false }, { id: "c", label: "Code-split by route — load each page's code only when that route is visited", correct: true }, { id: "d", label: "Replace JavaScript with WebAssembly for smaller binary sizes", correct: false }] },
  { id: "fe-perf-3", dimension: "performance", difficultyB: 0.5, stem: "An expensive React component re-renders on every parent render even though its own props have not changed. Best fix:", choices: [{ id: "a", label: "Move the component to a separate file to isolate re-renders", correct: false }, { id: "b", label: "Wrap it in `React.memo` so it skips re-rendering when props are shallowly equal", correct: true }, { id: "c", label: "Convert it to a class component and implement `shouldComponentUpdate`", correct: false }, { id: "d", label: "Use `useCallback` on the component function itself", correct: false }] },
  { id: "fe-a11y-1", dimension: "accessibility", difficultyB: 0, stem: "A button shows only a search icon SVG with no visible text. A screen reader announces 'button'. Best fix:", choices: [{ id: "a", label: "Add a `title` attribute to the SVG element", correct: false }, { id: "b", label: "Add `aria-label='Search'` to the button element so screen readers announce a meaningful name", correct: true }, { id: "c", label: "Add `role='img'` to the SVG", correct: false }, { id: "d", label: "Hide the button from screen readers with `aria-hidden='true'`", correct: false }] },
  { id: "fe-a11y-2", dimension: "accessibility", difficultyB: 0.5, stem: "A modal opens but keyboard focus stays behind the overlay. Users can tab to content under the modal. Best fix:", choices: [{ id: "a", label: "Add `tabIndex='-1'` to all background elements when the modal is open", correct: false }, { id: "b", label: "Move focus to the modal on open, trap Tab within it, and restore focus to the trigger on close", correct: true }, { id: "c", label: "Apply `pointer-events: none` to the background to block mouse interaction", correct: false }, { id: "d", label: "Use `position: fixed` on the modal to visually cover background content", correct: false }] },
  { id: "fe-a11y-3", dimension: "accessibility", difficultyB: 0.5, stem: "Status badges show 'Active' in green and 'Inactive' in grey. A colour-blind user cannot distinguish them. Minimum WCAG 2.1 AA fix:", choices: [{ id: "a", label: "Add a tooltip showing the status text on hover", correct: false }, { id: "b", label: "Use an icon or text label in addition to colour — colour alone must not be the only visual means of conveying information", correct: true }, { id: "c", label: "Change grey to a darker shade that meets the contrast ratio requirement", correct: false }, { id: "d", label: "Add an `aria-label` with the status text to the badge element", correct: false }] },

  // ─── Full-Stack Engineer (8 items) ───────────────────────────────────────────
  { id: "fs-ts-1", dimension: "typescript", difficultyB: 0, stem: "A function returns `string | undefined`. The caller needs a `string`. Safest approach:", choices: [{ id: "a", label: "Cast with `as string` — the caller knows it will never be undefined", correct: false }, { id: "b", label: "Use the non-null assertion `!` — equivalent to casting", correct: false }, { id: "c", label: "Check `if (value !== undefined)` before use — TypeScript narrows the type inside the block", correct: true }, { id: "d", label: "Change the return type to `string` and rely on runtime checks", correct: false }] },
  { id: "fs-ts-2", dimension: "typescript", difficultyB: 0.5, stem: "You want a type that accepts only the keys of another type. Correct TypeScript utility type:", choices: [{ id: "a", label: "`Partial<T>` — makes all properties optional", correct: false }, { id: "b", label: "`keyof T` — produces a union type of T's property names", correct: true }, { id: "c", label: "`Readonly<T>` — makes all properties read-only", correct: false }, { id: "d", label: "`Record<T, V>` — creates an object type from T keys", correct: false }] },
  { id: "fs-bapi-1", dimension: "backend_apis", difficultyB: 0, stem: "A Next.js Server Action receives user input. Before doing anything with it, you should:", choices: [{ id: "a", label: "Trust it — Server Actions only receive data from your own frontend", correct: false }, { id: "b", label: "Validate and sanitise it with a schema library (e.g. Zod) — Server Actions can be called directly via fetch by any client", correct: true }, { id: "c", label: "Check the user's session — if authenticated, the input is safe", correct: false }, { id: "d", label: "Sanitise only string fields — numbers and booleans cannot carry malicious payloads", correct: false }] },
  { id: "fs-bapi-2", dimension: "backend_apis", difficultyB: 0.5, stem: "You need the same data-fetching logic in both a Server Component and a Server Action. Best approach:", choices: [{ id: "a", label: "Copy-paste the query into both places — duplication is clearer than abstraction", correct: false }, { id: "b", label: "Extract a shared async function in a `lib/` file; import it into both the component and the action", correct: true }, { id: "c", label: "Call the Server Action from inside the Server Component using `fetch()`", correct: false }, { id: "d", label: "Use a global singleton that caches the data and is shared between contexts", correct: false }] },
  { id: "fs-db-1", dimension: "databases", difficultyB: 0, stem: "You add a NOT NULL column `status` to a table with 2M existing rows. The migration fails. Most likely reason:", choices: [{ id: "a", label: "Postgres does not support adding columns to existing tables", correct: false }, { id: "b", label: "Existing rows cannot satisfy NOT NULL without a DEFAULT value or a backfill step", correct: true }, { id: "c", label: "The migration ran out of disk space", correct: false }, { id: "d", label: "The column name conflicts with a reserved keyword", correct: false }] },
  { id: "fs-db-2", dimension: "databases", difficultyB: 0.5, stem: "Two concurrent requests both read balance=100, then each deduct 50 and write 50. Final balance is 50 instead of 0. This is a:", choices: [{ id: "a", label: "Deadlock — both transactions are blocking each other", correct: false }, { id: "b", label: "Lost update / race condition — the second write overwrites the first without seeing it", correct: true }, { id: "c", label: "Foreign key violation — the references are not consistent", correct: false }, { id: "d", label: "Connection pool exhaustion — requests are queuing", correct: false }] },
  { id: "fs-ps-1", dimension: "product_sense", difficultyB: 0, stem: "You are asked to add a feature. The spec has three edge cases that together affect less than 0.1% of users but will triple implementation time. Best approach:", choices: [{ id: "a", label: "Implement all edge cases — incomplete features erode trust", correct: false }, { id: "b", label: "Skip all edge cases — 99.9% of users won't notice", correct: false }, { id: "c", label: "Ship the core feature, document known limitations, and prioritise edge cases based on actual user impact data after launch", correct: true }, { id: "d", label: "Ask the PM to remove the edge cases from scope permanently", correct: false }] },
  { id: "fs-ps-2", dimension: "product_sense", difficultyB: 0.5, stem: "Users are dropping off at the onboarding step asking for their phone number. You don't use the phone number anywhere in the product yet. Best decision:", choices: [{ id: "a", label: "Keep it — you might need it in the future", correct: false }, { id: "b", label: "Make it optional — reduce friction while preserving the collection path", correct: false }, { id: "c", label: "Remove the field entirely until there is a product use case for it — unnecessary friction costs activation", correct: true }, { id: "d", label: "Add copy explaining why you need it — transparency reduces hesitation", correct: false }] },

  // ─── Mobile Engineer (8 items) ───────────────────────────────────────────────
  { id: "mo-nl-1", dimension: "native_language", difficultyB: 0, stem: "In Swift/Kotlin, what is the primary purpose of structured concurrency (async/await)?", choices: [{ id: "a", label: "To run tasks on the main thread only, preventing UI freezes", correct: false }, { id: "b", label: "To write asynchronous code that reads sequentially, with automatic cancellation propagation through the call hierarchy", correct: true }, { id: "c", label: "To replace callbacks with completion handlers for better performance", correct: false }, { id: "d", label: "To share mutable state safely between threads using locks", correct: false }] },
  { id: "mo-nl-2", dimension: "native_language", difficultyB: 0.5, stem: "A Swift optional `let user: User? = getUser()`. Safest way to use its `name` property:", choices: [{ id: "a", label: "`user!.name` — force unwrap; crash if nil", correct: false }, { id: "b", label: "`user?.name ?? 'Unknown'` — safe optional chaining with a fallback default", correct: true }, { id: "c", label: "`(user as! User).name` — force cast to non-optional", correct: false }, { id: "d", label: "`user.name` — the compiler will warn if nil is possible", correct: false }] },
  { id: "mo-sa-1", dimension: "state_architecture", difficultyB: 0, stem: "User taps a button in a SwiftUI/Compose view. The view should not contain business logic directly because:", choices: [{ id: "a", label: "Views are re-rendered too frequently and would duplicate logic on each render", correct: false }, { id: "b", label: "Keeping logic in a ViewModel/StateHolder makes it testable in isolation and reusable across multiple views", correct: true }, { id: "c", label: "Views cannot access network or database APIs directly", correct: false }, { id: "d", label: "The operating system restricts complex computations in UI thread handlers", correct: false }] },
  { id: "mo-sa-2", dimension: "state_architecture", difficultyB: 0.5, stem: "A screen fetches a list and lets users filter it. Where should the filter state live?", choices: [{ id: "a", label: "In the backend — filter on the server and re-fetch on every change", correct: false }, { id: "b", label: "In a global app-level state store — filters affect the whole app", correct: false }, { id: "c", label: "In the ViewModel/StateHolder scoped to this screen — filter state is local to this view", correct: true }, { id: "d", label: "Directly in the view layer as a local UI state variable", correct: false }] },
  { id: "mo-perf-1", dimension: "performance", difficultyB: 0, stem: "A list of 10,000 items causes jank on scroll. The fix is:", choices: [{ id: "a", label: "Reduce image resolution so each cell renders faster", correct: false }, { id: "b", label: "Use a lazy list (LazyColumn/UITableView) that only renders cells visible on screen", correct: true }, { id: "c", label: "Pre-render all cells at launch so scrolling is instant", correct: false }, { id: "d", label: "Paginate to load only 50 items at a time and disable scrolling beyond that", correct: false }] },
  { id: "mo-perf-2", dimension: "performance", difficultyB: 0.5, stem: "The app loads a large image from the network every time the same profile screen opens. Best fix:", choices: [{ id: "a", label: "Reduce the image dimensions server-side", correct: false }, { id: "b", label: "Use an image caching library (Kingfisher/Glide/Coil) that stores decoded images in memory and disk cache", correct: true }, { id: "c", label: "Convert images to WebP format for faster download", correct: false }, { id: "d", label: "Load images on a background thread to avoid blocking the UI", correct: false }] },
  { id: "mo-rel-1", dimension: "release", difficultyB: 0, stem: "A critical bug is discovered in version 2.3 of your iOS app. Users on 2.3 are affected. Best immediate action:", choices: [{ id: "a", label: "Withdraw version 2.3 from the App Store to prevent new installs", correct: false }, { id: "b", label: "Fix the bug, submit a 2.3.1 patch to the App Store expedited review, and communicate the timeline to users", correct: true }, { id: "c", label: "Push a server-side config change to disable the affected feature remotely", correct: false }, { id: "d", label: "Wait for the next major release cycle to include the fix", correct: false }] },
  { id: "mo-rel-2", dimension: "release", difficultyB: 0.5, stem: "You want to test a new checkout flow with 10% of Android users before a full rollout. Best approach:", choices: [{ id: "a", label: "Build two separate APKs and distribute them manually to different user groups", correct: false }, { id: "b", label: "Use Google Play staged rollout combined with a remote feature flag — route eligible users to the new flow without a new binary", correct: true }, { id: "c", label: "Release to internal testers only and collect feedback before any public release", correct: false }, { id: "d", label: "A/B test in staging only — production testing is too risky for checkout flows", correct: false }] },

  // ─── DevOps / SRE (10 items) ─────────────────────────────────────────────────
  { id: "do-k8s-1", dimension: "kubernetes", difficultyB: 0, stem: "A Pod crashes repeatedly with `CrashLoopBackOff`. First diagnostic step:", choices: [{ id: "a", label: "`kubectl delete pod` — restarting forces a clean state", correct: false }, { id: "b", label: "`kubectl logs <pod> --previous` — reads the logs from the last failed container run", correct: true }, { id: "c", label: "`kubectl describe node` — the issue is likely a node resource problem", correct: false }, { id: "d", label: "`kubectl rollout undo` — roll back to the previous Deployment version", correct: false }] },
  { id: "do-k8s-2", dimension: "kubernetes", difficultyB: 0.5, stem: "A Deployment has 3 replicas but all pods land on the same node. You want pods spread across nodes for resilience. Correct Kubernetes feature:", choices: [{ id: "a", label: "ResourceQuota — limits how many pods run per namespace", correct: false }, { id: "b", label: "Pod Topology Spread Constraints — distributes pods evenly across nodes, zones, or racks", correct: true }, { id: "c", label: "PodDisruptionBudget — ensures a minimum number of pods stay running during disruptions", correct: false }, { id: "d", label: "Affinity rules on the node — pulls pods toward a specific node", correct: false }] },
  { id: "do-iac-1", dimension: "iac", difficultyB: 0, stem: "You hand-edit a cloud resource in the AWS console that Terraform manages. Next `terraform apply` will:", choices: [{ id: "a", label: "Detect no changes — Terraform only tracks what it last deployed", correct: false }, { id: "b", label: "Detect drift and attempt to revert the resource to match the Terraform state", correct: true }, { id: "c", label: "Fail with a conflict error — Terraform locks resources it manages", correct: false }, { id: "d", label: "Merge the console change into the Terraform state automatically", correct: false }] },
  { id: "do-iac-2", dimension: "iac", difficultyB: 0.5, stem: "Two engineers run `terraform apply` simultaneously on the same workspace. Risk and prevention:", choices: [{ id: "a", label: "No risk — Terraform locks apply operations", correct: false }, { id: "b", label: "State corruption risk — use remote state with locking (e.g. S3 + DynamoDB or Terraform Cloud) to prevent concurrent applies", correct: true }, { id: "c", label: "The second apply will wait until the first completes — built-in queuing", correct: false }, { id: "d", label: "Both applies succeed — Terraform merges state changes automatically", correct: false }] },
  { id: "do-cloud-1", dimension: "cloud", difficultyB: 0, stem: "An EC2 instance needs to read from S3 without hardcoding credentials. Best approach:", choices: [{ id: "a", label: "Store credentials in a `.env` file on the instance", correct: false }, { id: "b", label: "Attach an IAM Role to the instance — the SDK retrieves temporary credentials automatically via the instance metadata service", correct: true }, { id: "c", label: "Pass credentials as environment variables in the EC2 user data script", correct: false }, { id: "d", label: "Use a shared IAM User and distribute the access key to all instances", correct: false }] },
  { id: "do-cloud-2", dimension: "cloud", difficultyB: 0.5, stem: "An application runs in us-east-1. A region failure would take it down entirely. Minimum architecture for multi-region resilience:", choices: [{ id: "a", label: "Multi-AZ deployment within us-east-1 — AZs are physically separate data centres", correct: false }, { id: "b", label: "Deploy to a second region (e.g. eu-west-1) with Route 53 health checks and failover routing", correct: true }, { id: "c", label: "Use a CDN — CloudFront serves from multiple regions automatically", correct: false }, { id: "d", label: "Enable S3 Cross-Region Replication for all data — compute failure is handled automatically", correct: false }] },
  { id: "do-obs-1", dimension: "observability", difficultyB: 0, stem: "A microservice is slow but CPU and memory metrics look fine. What signal are you missing?", choices: [{ id: "a", label: "Add more logging — verbose logs will surface the bottleneck", correct: false }, { id: "b", label: "Distributed traces — they show where latency is spent across service boundaries and external calls", correct: true }, { id: "c", label: "Check disk I/O — slow disk reads are the most common cause of service latency", correct: false }, { id: "d", label: "Increase the scrape interval for Prometheus — metrics may be stale", correct: false }] },
  { id: "do-obs-2", dimension: "observability", difficultyB: 0.5, stem: "Your on-call alert fires at 3am for a spike in error rate that resolves itself in 2 minutes. This happens weekly. Best improvement:", choices: [{ id: "a", label: "Lower the error rate threshold to catch issues earlier", correct: false }, { id: "b", label: "Add sustained-window alerting — only fire if the error rate stays elevated for N minutes, filtering transient spikes", correct: true }, { id: "c", label: "Add a 5-minute delay to all alerts to filter transient issues", correct: false }, { id: "d", label: "Remove the alert — if it self-resolves, it is not worth waking someone up", correct: false }] },
  { id: "do-cicd-1", dimension: "cicd", difficultyB: 0, stem: "A CI pipeline takes 40 minutes. Developers stop waiting for it and merge without green checks. First improvement to try:", choices: [{ id: "a", label: "Make the pipeline optional — teams can choose when to run it", correct: false }, { id: "b", label: "Parallelise independent jobs (lint, unit tests, build) that currently run sequentially", correct: true }, { id: "c", label: "Only run the full pipeline on the main branch — not on every PR", correct: false }, { id: "d", label: "Upgrade the CI runners to faster hardware", correct: false }] },
  { id: "do-cicd-2", dimension: "cicd", difficultyB: 0.5, stem: "A deployment to production fails 10 minutes after rollout — a config value is wrong for production. How should this have been caught?", choices: [{ id: "a", label: "Manual QA testing in staging before every deploy", correct: false }, { id: "b", label: "Automated smoke tests in the CD pipeline that validate config and connectivity in the target environment before marking the deploy successful", correct: true }, { id: "c", label: "Feature flags — disable the feature until the config is confirmed correct", correct: false }, { id: "d", label: "Blue/green deployment — keep the old version running alongside the new one", correct: false }] },

  // ─── Data Analyst (8 items) ──────────────────────────────────────────────────
  { id: "da-sql-1", dimension: "sql", difficultyB: 0, stem: "You need each user's most recent order, including users with no orders. Which approach is correct?", choices: [{ id: "a", label: "INNER JOIN + WHERE orders.created_at = MAX(orders.created_at)", correct: false }, { id: "b", label: "LEFT JOIN users to orders, then use ROW_NUMBER() OVER (PARTITION BY user_id ORDER BY created_at DESC) and filter row = 1", correct: true }, { id: "c", label: "SELECT * FROM users WHERE user_id IN (SELECT MAX(created_at) FROM orders GROUP BY user_id)", correct: false }, { id: "d", label: "Two separate queries — one for users, one for most recent orders — joined in application code", correct: false }] },
  { id: "da-sql-2", dimension: "sql", difficultyB: 0.5, stem: "A query on a 100M-row events table with `WHERE event_date BETWEEN '2024-01-01' AND '2024-01-31'` runs in 8 seconds. EXPLAIN shows a full table scan. Best fix:", choices: [{ id: "a", label: "Add `LIMIT 1000` to reduce the result set", correct: false }, { id: "b", label: "Create an index on `event_date` — the database can seek directly to the date range", correct: true }, { id: "c", label: "Move data older than 1 year to an archive table", correct: false }, { id: "d", label: "Rewrite as `WHERE YEAR(event_date) = 2024 AND MONTH(event_date) = 1`", correct: false }] },
  { id: "da-stat-1", dimension: "statistics", difficultyB: 0.5, stem: "An A/B test shows +15% conversion with p=0.03 (threshold p<0.05). A stakeholder asks to declare a winner. What should you check first?", choices: [{ id: "a", label: "The test has reached significance — declare the variant the winner", correct: false }, { id: "b", label: "Check that you had a pre-specified sample size and did not peek at results multiple times — early stopping inflates false positive rates", correct: true }, { id: "c", label: "Run the test for another week to build more confidence", correct: false }, { id: "d", label: "Lower the significance threshold to p<0.01 to be more rigorous", correct: false }] },
  { id: "da-stat-2", dimension: "statistics", difficultyB: 0, stem: "Ice cream sales and drowning incidents are strongly correlated (r = 0.91). The simplest correct conclusion is:", choices: [{ id: "a", label: "Ice cream causes people to drown — correlation implies causation at r > 0.9", correct: false }, { id: "b", label: "Both are driven by a confounding variable (hot weather) — correlation does not imply causation", correct: true }, { id: "c", label: "Drowning causes stress that makes people want ice cream", correct: false }, { id: "d", label: "The correlation is spurious — ignore it entirely", correct: false }] },
  { id: "da-dom-1", dimension: "domain_acumen", difficultyB: 0.5, stem: "MAU increased 20% this month. Before reporting this as growth, what should you investigate first?", choices: [{ id: "a", label: "Whether the 'active' definition changed, whether a one-off campaign inflated the number, and whether prior cohort retention is holding", correct: true }, { id: "b", label: "Whether the server infrastructure can support the increased load", correct: false }, { id: "c", label: "Whether competitors saw similar growth — it may be a market trend", correct: false }, { id: "d", label: "Whether the 20% exceeds the 12-month average growth rate", correct: false }] },
  { id: "da-dom-2", dimension: "domain_acumen", difficultyB: 0, stem: "A PM asks for a report on 'user engagement.' What is your first step?", choices: [{ id: "a", label: "Pull the most-used engagement metrics from the dashboard", correct: false }, { id: "b", label: "Align on a precise definition of engagement for this product context before pulling any data", correct: true }, { id: "c", label: "Build a composite engagement score combining all available metrics", correct: false }, { id: "d", label: "Use DAU/MAU ratio — it is the industry standard engagement metric", correct: false }] },
  { id: "da-story-1", dimension: "storytelling", difficultyB: 0, stem: "You compare monthly revenue across 5 product lines over 2 years. An exec needs to see which grew fastest. Best chart type:", choices: [{ id: "a", label: "Pie chart showing current revenue share per product line", correct: false }, { id: "b", label: "Line chart with one line per product line — shows growth trends and relative trajectory clearly", correct: true }, { id: "c", label: "Stacked bar chart showing total revenue with product breakdown per month", correct: false }, { id: "d", label: "Scatter plot with month on x-axis and revenue on y-axis per product", correct: false }] },
  { id: "da-story-2", dimension: "storytelling", difficultyB: 0.5, stem: "Your first slide shows a table of 12 metrics with 24 months of data. The VP seems lost. What went wrong and how do you fix it?", choices: [{ id: "a", label: "The data is too complex to present simply — stick to written reports", correct: false }, { id: "b", label: "Lead with the key insight and recommendation in one sentence; support with one clear chart; move detail to the appendix", correct: true }, { id: "c", label: "Use a live dashboard instead of slides so the VP can explore the data themselves", correct: false }, { id: "d", label: "Add more context by including the raw data source behind each metric", correct: false }] },

  // ─── QA / Test Engineer (8 items) ────────────────────────────────────────────
  { id: "qa-api-1", dimension: "api_testing", difficultyB: 0.5, stem: "The Orders API renames `orderId` to `order_id`. The Checkout consumer breaks in production. Which testing strategy would have caught this before deploy?", choices: [{ id: "a", label: "End-to-end tests that exercise the full checkout flow", correct: false }, { id: "b", label: "Consumer-driven contract testing — the consumer defines the expected contract; the provider CI validates it before every deploy", correct: true }, { id: "c", label: "Integration tests that mock the Orders API response", correct: false }, { id: "d", label: "Unit tests on the serialisation/deserialisation code in both services", correct: false }] },
  { id: "qa-api-2", dimension: "api_testing", difficultyB: 0, stem: "Testing `DELETE /users/{id}`. Which test cases are essential?", choices: [{ id: "a", label: "Happy path only — deleting a valid user", correct: false }, { id: "b", label: "Happy path (204), unauthorised call (401), deleting non-existent user (404), and idempotency check (deleting same user twice)", correct: true }, { id: "c", label: "Happy path and a large volume test to check rate limits", correct: false }, { id: "d", label: "Only negative cases — the happy path is covered by the developer's own tests", correct: false }] },
  { id: "qa-prog-1", dimension: "programming", difficultyB: 0.5, stem: "Tests share a hardcoded test user `test@example.com`. Running two tests in parallel causes interference. Best fix:", choices: [{ id: "a", label: "Run tests sequentially — parallelism causes test interference", correct: false }, { id: "b", label: "Each test creates and destroys its own isolated test data using factories or fixtures with unique data per run", correct: true }, { id: "c", label: "Add `sleep(1000)` between tests to avoid timing conflicts", correct: false }, { id: "d", label: "Mock the database so tests do not touch real data", correct: false }] },
  { id: "qa-prog-2", dimension: "programming", difficultyB: 0, stem: "Selenium tests break whenever a developer moves a button. You use CSS selectors like `.btn.btn-primary.checkout`. Better approach:", choices: [{ id: "a", label: "Use XPath — it is more specific than CSS selectors", correct: false }, { id: "b", label: "Add `data-testid` attributes to key UI elements and target those — decoupled from styling and structure", correct: true }, { id: "c", label: "Take screenshot baseline tests instead of element selectors", correct: false }, { id: "d", label: "Coordinate with developers to never change CSS class names", correct: false }] },
  { id: "qa-qs-1", dimension: "quality_strategy", difficultyB: 0, stem: "Your team has 2,000 unit tests (5ms each), 200 integration tests (500ms each), and 50 E2E tests (30s each). CI takes 25 minutes. The test pyramid principle says:", choices: [{ id: "a", label: "Increase the number of E2E tests — they test the most realistic user scenarios", correct: false }, { id: "b", label: "The ratio is inverted — most logic should be covered by fast unit tests; E2E should cover only critical user journeys", correct: true }, { id: "c", label: "Replace integration tests with more E2E tests for better coverage", correct: false }, { id: "d", label: "The current distribution is fine — runtime is the only concern", correct: false }] },
  { id: "qa-qs-2", dimension: "quality_strategy", difficultyB: 0.5, stem: "A feature has zero automated tests. Stakeholders want it shipped tomorrow. Minimum QA action before release:", choices: [{ id: "a", label: "Skip testing — ship it and document as technical debt", correct: false }, { id: "b", label: "Do a focused exploratory test of the happy path and top 2-3 failure scenarios; automate critical paths in the next sprint", correct: true }, { id: "c", label: "Block the release until proper automated tests are written", correct: false }, { id: "d", label: "Ask developers to write unit tests for their own code", correct: false }] },
  { id: "qa-ui-1", dimension: "ui_automation", difficultyB: 0, stem: "A test clicks a button then immediately asserts the result appears. Passes locally, fails in CI 30% of the time with 'element not found'. Root cause and fix:", choices: [{ id: "a", label: "The CI machine is slower — increase the implicit wait timeout globally", correct: false }, { id: "b", label: "The test is not waiting for the async operation to complete — use explicit waits for the expected element state", correct: true }, { id: "c", label: "The element selector is wrong in CI — add a fallback selector", correct: false }, { id: "d", label: "Run CI on a faster machine to reduce timing issues", correct: false }] },
  { id: "qa-ui-2", dimension: "ui_automation", difficultyB: 0, stem: "Locating the 'Submit Order' button. Which selector strategy is most resilient to UI refactoring?", choices: [{ id: "a", label: "XPath with absolute position: `//div[3]/button[2]`", correct: false }, { id: "b", label: "CSS class selector: `.btn-primary.submit`", correct: false }, { id: "c", label: "Test attribute: `[data-testid='submit-order-btn']` — stable, decoupled from styling", correct: true }, { id: "d", label: "Link text: `Submit Order` — matches visible text content", correct: false }] },

  // ─── AI Engineer - NEW CURRICULUM QUESTIONS (15) ───────────────────
  { id: "ai-voice-1", dimension: "voice_multimodal", difficultyB: 0, stem: "You want to transcribe audio from user support calls in real-time and pass the text to an LLM. Which approach gives the lowest latency?", choices: [{ id: "a", label: "Record the full call, then send the audio file to a batch transcription API", correct: false }, { id: "b", label: "Use a streaming STT API (e.g. Deepgram) that sends partial transcripts as words are spoken", correct: true }, { id: "c", label: "Use a local speech recognition library running on the server", correct: false }, { id: "d", label: "Convert audio to text client-side in the browser", correct: false }] },
  { id: "ai-voice-2", dimension: "voice_multimodal", difficultyB: 0.5, stem: "Your voice AI pipeline latency breakdown is: STT 120ms, LLM TTFT 350ms, TTS 180ms. The product requires sub-500ms to first audio byte. What do you optimise first?", choices: [{ id: "a", label: "Switch to a faster STT provider — it contributes 120ms to the budget", correct: false }, { id: "b", label: "Reduce LLM TTFT — it is the largest contributor at 350ms; smaller model or prompt caching", correct: true }, { id: "c", label: "Reduce TTS latency — it contributes 180ms", correct: false }, { id: "d", label: "Move STT processing to the client to eliminate one network hop", correct: false }] },
  { id: "ai-voice-3", dimension: "voice_multimodal", difficultyB: 1, stem: "Your voice assistant keeps cutting off mid-sentence when background noise triggers the VAD (Voice Activity Detection) system. What is the correct fix?", choices: [{ id: "a", label: "Increase the TTS output buffer size so pauses are bridged", correct: false }, { id: "b", label: "Disable VAD entirely and use fixed-length audio chunks", correct: false }, { id: "c", label: "Tune the VAD silence threshold on real call data — make it less sensitive to brief noise events while keeping interrupt latency low", correct: true }, { id: "d", label: "Switch to a push-to-talk model where users press a button to speak", correct: false }] },
  { id: "ai-eval-1", dimension: "llm_fundamentals_evals", difficultyB: 1, stem: "You set up an LLM-as-judge to score your RAG system's answers. After a week, you notice the judge consistently rates long answers higher regardless of correctness. This is:", choices: [{ id: "a", label: "Working correctly — longer answers are usually more complete", correct: false }, { id: "b", label: "A judge bias: length bias is one of the most common LLM-as-judge calibration failures; fix by adding explicit anti-length-bias instructions and testing with short correct vs long incorrect answers", correct: true }, { id: "c", label: "A retrieval problem — the RAG system is pulling too many chunks", correct: false }, { id: "d", label: "A prompt injection attack from users", correct: false }] },
  { id: "ai-eval-2", dimension: "llm_fundamentals_evals", difficultyB: 1, stem: "Your eval CI pipeline runs 500 test cases on every PR. It passes. But in production, users report 30% of answers are wrong. Most likely cause:", choices: [{ id: "a", label: "The CI environment uses a different Python version", correct: false }, { id: "b", label: "The 500 test cases do not reflect the real distribution of production queries — eval set coverage gap", correct: true }, { id: "c", label: "The LLM model was updated between CI run and deployment", correct: false }, { id: "d", label: "Rate limits are higher in production than in test environment", correct: false }] },
  { id: "ai-ctx-1", dimension: "context_engineering", difficultyB: 1, stem: "You are building a customer support agent that needs to access a CRM, a ticket system, and a knowledge base. You want to add new data sources without redeploying the agent. Which architecture fits?", choices: [{ id: "a", label: "Hard-code API calls for each data source as separate tools in the agent", correct: false }, { id: "b", label: "Build a middleware aggregator that merges all sources into one endpoint", correct: false }, { id: "c", label: "Expose each data source as an MCP server; the agent discovers and calls them via the MCP client protocol — new sources are added as servers without changing agent code", correct: true }, { id: "d", label: "Store all source data in the agent's context window on startup", correct: false }] },
  { id: "ai-ctx-2", dimension: "context_engineering", difficultyB: 1, stem: "A conversational AI must maintain context across a 2-hour support session. The context window fills up after ~30 messages. Best strategy:", choices: [{ id: "a", label: "Truncate the oldest messages when the window fills", correct: false }, { id: "b", label: "Use a model with a larger context window — 200k tokens solves the problem", correct: false }, { id: "c", label: "Compress earlier conversation turns using a summarisation chain, keeping a running summary + last N raw turns in the window", correct: true }, { id: "d", label: "Store all messages in the database and re-inject the full history on each turn", correct: false }] },
  { id: "ai-agt-1", dimension: "agentic_systems", difficultyB: 1, stem: "Your LangGraph multi-agent workflow enters an infinite loop: orchestrator asks sub-agent A, A asks B, B asks orchestrator, repeat. Correct fix:", choices: [{ id: "a", label: "Add a global timeout to the entire workflow run", correct: false }, { id: "b", label: "Increase the model temperature so agents are less likely to repeat the same request", correct: false }, { id: "c", label: "Add a conditional edge with a maximum iteration counter — after N loops, route to a human-review interrupt node instead of continuing", correct: true }, { id: "d", label: "Run A and B as a single merged agent to eliminate the back-and-forth", correct: false }] },
  { id: "ai-agt-2", dimension: "agentic_systems", difficultyB: 1, stem: "You are choosing between LangGraph, CrewAI, and AutoGen for a multi-agent system that must recover from partial failures mid-workflow. Which matters most for this requirement?", choices: [{ id: "a", label: "Which framework has the most GitHub stars", correct: false }, { id: "b", label: "Whether the framework supports checkpoint/resume — the ability to persist workflow state and restart from the last successful step without redoing completed work", correct: true }, { id: "c", label: "Which framework uses the fewest API calls", correct: false }, { id: "d", label: "Whether the framework supports streaming output to the frontend", correct: false }] },
