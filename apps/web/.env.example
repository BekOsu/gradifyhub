# Database
DATABASE_URL=             # from Neon dashboard

# App Configuration
SKILL_GROUPS=Backend,Frontend,AI    # comma-separated learning tracks for onboarding
ADMIN_EMAILS=                        # comma-separated list of admin emails

# Auth
BETTER_AUTH_SECRET=       # run: openssl rand -base64 32
BETTER_AUTH_URL=          # http://localhost:3000 (dev) | https://gradifyhub.com (prod)
NEXT_PUBLIC_BETTER_AUTH_URL=  # same as BETTER_AUTH_URL
NEXT_PUBLIC_APP_URL=          # optional alias for frontend base URL

# OAuth providers
GOOGLE_CLIENT_ID=         # Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_SECRET=     # OAuth 2.0 Client ID, callback: /api/auth/callback/google
GITHUB_CLIENT_ID=         # GitHub → Settings → Developer settings → OAuth Apps
GITHUB_CLIENT_SECRET=     # same — callback: /api/auth/callback/github

# Email
RESEND_API_KEY=           # from Resend dashboard (required for email verification)
RESEND_FROM_EMAIL=        # e.g. GradifyHub <noreply@gradifyhub.com> — must be a verified sender/domain

# AI
AGENT_ANTHROPIC_API_KEY=  # from Anthropic console (used by LangGraph agents)
AGENT_OPENAI_API_KEY=     # from OpenAI (used by voice/mock interview)
# Compatibility aliases (optional):
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# AI fallback providers (used as primary for free plan, fallback for paid plans)
# Order in routing: Groq → DeepSeek → Gemini → HuggingFace → Cohere → Together → Fireworks
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=         # default: https://api.deepseek.com
DEEPSEEK_MODEL=            # default: deepseek-chat
GROQ_API_KEY=
GROQ_MODEL=                # default: llama-3.3-70b-versatile
HUGGINGFACE_API_KEY=       # free tier — generous limits
HUGGINGFACE_MODEL=         # default: meta-llama/Meta-Llama-3-8B-Instruct
COHERE_API_KEY=            # free tier — 1K calls/month
COHERE_MODEL=              # default: command-r
GOOGLE_API_KEY=            # Google Gemini — free tier with generous limits
GEMINI_MODEL=              # fast model, e.g. gemini-2.5-flash
GEMINI_PRO_MODEL=          # quality model, e.g. gemini-2.5-pro (used in primary chain)
TOGETHER_API_KEY=
TOGETHER_BASE_URL=         # default: https://api.together.xyz/v1
TOGETHER_MODEL=            # optional, required to activate Together in routing
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=        # default: https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=           # optional, required to activate Fireworks in routing

# OpenRouter (user-funded BYOK + platform managed inference)
OPENROUTER_API_KEY=            # platform key used for pro/career users
OPENROUTER_ENCRYPTION_KEY=     # run: openssl rand -base64 32 (must decode to exactly 32 bytes)
OPENROUTER_PRO_ALLOWLIST=      # comma-separated OR model IDs for pro/career override; leave empty for defaults

# Payments — LemonSqueezy
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_PRO_MONTHLY=    # variant ID for Pro monthly plan
LEMONSQUEEZY_VARIANT_PRO_YEARLY=     # variant ID for Pro yearly plan

# Payments — NOWPayments (crypto)
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# ML sidecar (Python FastAPI — optional for V1)
ML_SIDECAR_URL=           # http://localhost:8000 (dev) | internal URL (prod)

# Observability
NEXT_PUBLIC_POSTHOG_KEY=          # from PostHog dashboard (public key for client-side tracking)
POSTHOG_KEY=                      # PostHog API key (server-side tracking)
SENTRY_DSN=

# Background jobs (Inngest)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Storage (Cloudflare R2)
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ENDPOINT=
